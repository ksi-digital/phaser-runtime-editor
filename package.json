{
    "name": "phaser-runtime-editor",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "demo": "vite --config vite.demo.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "phaser": "^3.60.0 || ^4.0.0"
    },
    "devDependencies": {
        "phaser": "^4.0.0-rc.6",
        "typescript": "^5.7.0",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^4.5.0"
    },
    "dependencies": {
        "@tweakpane/core": "^2.0.5",
        "tweakpane": "^4.0.0"
    }
}
